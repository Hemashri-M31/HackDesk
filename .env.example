APP_NAME=HackDesk
ENVIRONMENT=local
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2
LLM_INPUT_COST_PER_MILLION=0.15
LLM_OUTPUT_COST_PER_MILLION=0.60
LLM_FALLBACK_INPUT_COST_PER_MILLION=0.40
LLM_FALLBACK_OUTPUT_COST_PER_MILLION=1.60
DATABASE_URL=sqlite:///./usage.db
